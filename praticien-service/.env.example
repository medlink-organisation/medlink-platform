PRATICIEN_DB_NAME=praticien_db
PRATICIEN_DB_USERNAME=praticien
PRATICIEN_DB_PASSWORD=change-me

PRATICIEN_HTTP_PORT=8082
PRATICIEN_GRPC_PORT=9091

CONFIG_SERVICE_URL=http://host.docker.internal:8899
CONFIG_LABEL=main
EUREKA_SERVICE_URL=http://host.docker.internal:8761/eureka/
KEYCLOAK_ISSUER_URI=http://host.docker.internal:8081/realms/medlink

VAULT_URI=http://host.docker.internal:8200
PRATICIEN_VAULT_ROLE_ID=replace-me
PRATICIEN_VAULT_SECRET_ID=replace-me

JPA_DDL_AUTO=update
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APPLICATION=INFO
